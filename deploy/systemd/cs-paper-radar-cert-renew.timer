[Unit]
Description=Check/renew the CS Paper Radar certificate twice a day

[Timer]
# Short-lived (IP) certificates last ~6 days and renew at half-life; checking
# twice a day leaves several retries before expiry.
OnCalendar=*-*-* 04:17:00 UTC
OnCalendar=*-*-* 16:17:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
