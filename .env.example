# Copy to .env and adjust. Every value has a working default except TLS_DIR on the server.

# --- Server deployment (HTTPS via deploy/compose.server.yml) ---
COMPOSE_FILE=docker-compose.yml:deploy/compose.server.yml
TLS_DIR=/path/to/tls
HTTPS_PORT=

# --- Local web port (published on 127.0.0.1 unless APP_BIND changes; unused with the override) ---
APP_BIND=127.0.0.1
APP_PORT=8000

# --- Storage: SQLite DB + embedding model cache (must be writable by RADAR_UID) ---
DATA_PATH=./data
RADAR_UID=10001
RADAR_GID=10001

# --- Sources and scope ---
SOURCES=arxiv
ARXIV_CATEGORIES=cs.*,eess.SY,eess.SP,eess.AS,eess.IV
UPDATE_LOOKBACK_DAYS=4

# --- Embeddings: fastembed | hash | off ---
EMBEDDINGS=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
APP_EMBEDDING_THREADS=1
JOB_EMBEDDING_THREADS=4

# --- Ranking ---
TOP_N=20
TOP_MAX_PER_CATEGORY=4
# Override individual weights (renormalised to sum to 1), e.g. venue=0.3,novelty=0.25
SCORE_WEIGHTS=

SITE_NAME=CS Paper Radar
